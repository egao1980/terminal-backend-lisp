(defparameter +default-foreground-triple+ '(255 255 255))
(defparameter +default-background-triple+ '(0 0 0))

(defun %triple-rgb (triple)
  (apply #'tp:make-rgb triple))

(defun %make-default-palette ()
  "→ a fresh (simple-vector 256) of TP:RGB."
  (map 'simple-vector #'%triple-rgb +default-palette-triples+))
